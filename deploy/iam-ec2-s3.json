{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::proposal-studio-media-378356708213"
    },
    {
      "Sid": "MediaBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::proposal-studio-media-378356708213/*"
    }
  ]
}
