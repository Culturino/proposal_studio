# Copy to .env and fill in. .env is gitignored.
# ASP.NET maps double underscores to nested config.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=proposal_studio;Username=postgres;Password=
JwtSettings__SecretKey=

Seed__DemoUsers=false
Seed__AdminEmail=
Seed__AdminPassword=
Seed__AdminName=Administrator

# Optional. Empty = local wwwroot only (localhost). Set on the public host.
Storage__Bucket=
Storage__Prefix=
Storage__Region=eu-central-1
